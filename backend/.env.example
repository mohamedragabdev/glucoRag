# ==============================================================================
# GlucoRAG Laravel Backend — Environment Configuration Template
# ==============================================================================

APP_NAME=GlucoRAG
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-backend-service.onrender.com

# ------------------------------------------------------------------------------
# MySQL Database Configuration (Laravel Business & Auth Data)
# (Hosted externally on Aiven, TiDB Serverless, Railway, or Render MySQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=your-mysql-host.aivencloud.com
DB_PORT=3306
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_mysql_password
# DB_SSL_MODE=REQUIRED (if using Aiven / TiDB with SSL)

# ------------------------------------------------------------------------------
# Session & Queue Configuration
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) & Frontend URL
# ------------------------------------------------------------------------------
FRONTEND_URL=https://your-frontend.vercel.app
SANCTUM_STATEFUL_DOMAINS=your-frontend.vercel.app

# ------------------------------------------------------------------------------
# FastAPI RAG Service Integration (Server-to-Server)
# ------------------------------------------------------------------------------
RAG_SERVICE_URL=https://your-rag-service.onrender.com
RAG_INTERNAL_SECRET=your_secure_shared_secret_min_32_chars
RAG_TIMEOUT=45
